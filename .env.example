# Edward Jones | Client Product Insights — environment configuration
# Copy to .env.local for local development. Never commit real values.

# --- Database -----------------------------------------------------------------
# Leave DATABASE_URL empty locally to use the embedded PGlite database (PostgreSQL
# compiled to WebAssembly), stored in PGLITE_DATA_DIR. Production must use PostgreSQL.
DATABASE_URL=
# DATABASE_URL_UNPOOLED=        # optional direct connection for migrations when DATABASE_URL uses a pooler
PGLITE_DATA_DIR=.data/pglite
# MIGRATE_ON_START=false        # set true to apply migrations at runtime instead of during `npm run build`

# --- Application --------------------------------------------------------------
# Public base URL used in webhook payload links (detailUrl, apiUrl). Derived from the
# request host when empty. Set it in production, e.g. https://insights.example.com
APP_BASE_URL=
# Demo mode shows the synthetic-data indicator and enables "Reset demo data".
# Set to false in any environment that is not a demo.
DEMO_MODE=true
# Seed synthetic data automatically when the database is empty.
SEED_ON_EMPTY=true

# --- Administration -------------------------------------------------------------
# Comma-separated emails of signed-in viewers who may change integration settings, view or
# rotate credentials, and reset demo data. Cursor team admins qualify automatically.
APP_ADMIN_EMAILS=

# --- Agent API ----------------------------------------------------------------
# Comma-separated bearer keys accepted by /api/v1. When empty, a demo key is generated on
# first boot and shown (masked, revealable) on the Integrations page.
AGENT_API_KEYS=
# Default processing lease for claims, in seconds.
AUTOMATION_LEASE_SECONDS=300

# --- Outbound webhook ---------------------------------------------------------
# Optional. When set, these override the values configured on the Integrations page.
WEBHOOK_URL=
# Optional token sent as "Authorization: Bearer <token>" to the external destination
# (for example a Cursor automation webhook trigger's API key).
WEBHOOK_BEARER_TOKEN=
# Force automatic queueing of new submissions (true/false). When empty, the Integrations page setting applies.
AUTO_QUEUE_NEW_REQUESTS=
# HMAC-SHA256 signing secret (min 16 chars). When empty, one is generated on first boot.
WEBHOOK_SIGNING_SECRET=
WEBHOOK_TIMEOUT_MS=8000
WEBHOOK_MAX_ATTEMPTS=5
# Base delay for exponential backoff (15s, 30s, 60s, 120s… capped at 30 minutes, ±20% jitter)
WEBHOOK_RETRY_BASE_MS=15000
# Allow http:// webhook URLs for non-localhost hosts (not recommended)
WEBHOOK_ALLOW_HTTP=false
# In production, webhook destinations must resolve to public IPs. Set true only when the
# receiving workflow lives on a private network you control.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# --- Delivery worker ----------------------------------------------------------
# Run the delivery/lease worker inside the Next.js server process (long-running hosts).
DELIVERY_WORKER_INLINE=true
DELIVERY_WORKER_INTERVAL_MS=5000
# Used by `npm run worker` (standalone worker that calls POST /api/v1/webhooks/dispatch)
# AGENT_API_KEY=
